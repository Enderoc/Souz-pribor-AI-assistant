# Скопируйте в .env и подставьте ключ ОДНОГО провайдера. Файл .env в .gitignore.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OpenAI (или совместимый API) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Явный выбор провайдера (необязательно: иначе по тому, какой ключ задан)
# LLM_PROVIDER=openai

# Лимит длины ответа модели в токенах (по умолчанию 2500)
# MAX_OUTPUT_TOKENS=2500
